---
/**
 * An inline SVG icon. `name` accepts the old `lucide:tag` spelling as well as
 * `tag`, so call sites did not have to change when the package went.
 * Decorative by default (aria-hidden); pass `label` for one that carries meaning.
 */
import { ICONS, type IconName } from '../lib/icons';

interface Props { name: string; size?: number; class?: string; label?: string }
const { name, size = 16, class: className, label } = Astro.props;
const key = name.replace(/^[\w-]+:/, '') as IconName;
// `Object.hasOwn`, not a truthiness test: `ICONS` is a plain object, so
// `ICONS['constructor']` resolves up the prototype chain to a function, passes a
// `!body` guard, and gets stringified into the SVG by set:html. Reachable here
// because `name` is typed as a string to allow the `lucide:` prefix.
if (!Object.hasOwn(ICONS, key)) throw new Error(`Icon "${name}" is not in src/lib/icons.ts — copy its body there`);
const body = ICONS[key];
---
<svg
  xmlns="http://www.w3.org/2000/svg"
  viewBox="0 0 24 24"
  width={size}
  height={size}
  class={className}
  aria-hidden={label ? undefined : 'true'}
  role={label ? 'img' : undefined}
  aria-label={label}
  set:html={body}
/>
