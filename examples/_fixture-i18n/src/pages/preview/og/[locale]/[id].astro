---
/**
 * The generated card for one post, at its real size.
 * Route: /preview/og/<locale>/<id>
 *
 * This used to be the HTML template Playwright screenshotted into the PNG.
 * Since 2026-09-02 the cards are drawn by scripts/og.mjs (satori + sharp) on
 * every build, so there is no template to preview — the review affordance is
 * the finished PNG, which is also the only thing anyone will ever see. Edit
 * the template in og.mjs, rebuild, reload.
 */
import type { CollectionEntry } from 'astro:content';
import { getCollection } from 'astro:content';
import PreviewLayout from '../../../../layouts/PreviewLayout.astro';
import { urlSlug } from '../../../../lib/slug';

export async function getStaticPaths() {
  const posts = await getCollection('blog');
  return posts
    .filter((post) => !post.data.draft && !post.data.previewOnly)
    .map((post) => ({ params: { locale: post.data.locale, id: urlSlug(post.id) }, props: { post } }));
}

interface Props { post: CollectionEntry<'blog'> }
const { post } = Astro.props;
const src = `/og/${post.data.locale}/${urlSlug(post.id)}.png`;
---
<PreviewLayout title={`OG: ${post.data.title}`}>
  <h1>{post.data.title}</h1>
  <p class="muted">{post.data.locale} · <code>{src}</code> · 1200×630, drawn by <code>scripts/og.mjs</code></p>
  <img src={src} width="1200" height="630" alt={`Social card for ${post.data.title}`} style="max-width:100%;height:auto;border:1px solid #333" />
  <p><a href="/preview/og">← All cards</a></p>
</PreviewLayout>
