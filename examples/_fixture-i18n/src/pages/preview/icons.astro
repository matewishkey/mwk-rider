---
/**
 * Every icon the site ships, from the one place they live. Route: /preview/icons
 *
 * There is no icon family to pick any more (issue #31): the glyphs are inline
 * SVG bodies in src/lib/icons.ts, copied once from a permissive set, and this
 * page is simply that map rendered — so a missing or wrong glyph is visible
 * here before it is visible in a footer.
 */
import PreviewLayout from '../../layouts/PreviewLayout.astro';
import Icon from '../../components/Icon.astro';
import { ICONS } from '../../lib/icons';
const names = Object.keys(ICONS).sort();
---
<PreviewLayout title="Icons">
  <h1>Icons</h1>
  <p>{names.length} inline SVG glyphs in <code>src/lib/icons.ts</code>. Only what the pages use; nothing on the critical path; no package.</p>
  <ul style="display:flex;flex-wrap:wrap;gap:1.5rem;list-style:none;padding:0">
    {names.map((n) => (
      <li style="display:flex;flex-direction:column;align-items:center;gap:.4rem;width:6rem">
        <Icon name={n} size={28} />
        <code style="font-size:.75rem">{n}</code>
      </li>
    ))}
  </ul>
</PreviewLayout>
