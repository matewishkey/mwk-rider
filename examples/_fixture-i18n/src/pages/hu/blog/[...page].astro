---
import RootLayout from '../../../layouts/RootLayout.astro';
import Pagination from '../../../components/Pagination.astro';
import Icon from '../../../components/Icon.astro';
import { getCollection } from 'astro:content';
import { urlSlug } from '../../../lib/slug';
import type { GetStaticPaths, Page } from 'astro';
import type { CollectionEntry } from 'astro:content';

export const getStaticPaths: GetStaticPaths = async ({ paginate }) => {
  const all = await getCollection('blog');
  const posts = all
    .filter((p) => !p.data.draft && !p.data.previewOnly && p.data.locale === 'hu')
    .sort((a, b) => b.data.date.getTime() - a.data.date.getTime());
  return paginate(posts, { pageSize: 3 });
};

interface Props {
  page: Page<CollectionEntry<'blog'>>;
}
const { page } = Astro.props;

const allPosts = (await getCollection('blog'))
  .filter((p) => !p.data.draft && !p.data.previewOnly && p.data.locale === 'hu');
const typeCounts = new Map<string, number>();
const tagCounts = new Map<string, number>();
for (const p of allPosts) {
  typeCounts.set(p.data.type, (typeCounts.get(p.data.type) ?? 0) + 1);
  for (const t of p.data.tags) tagCounts.set(t, (tagCounts.get(t) ?? 0) + 1);
}
const sortedTypes = [...typeCounts.entries()].sort((a, b) => b[1] - a[1]);
const sortedTags = [...tagCounts.entries()].sort((a, b) => b[1] - a[1]);

const title = page.currentPage === 1 ? 'Blog' : `Blog · Oldal ${page.currentPage}`;
import { config as brandConfig } from '../../../../scripts/og.config.mjs';
const brand = brandConfig.brand;
// A description of its own, not the site tagline. 28 of this fixture's pages
// shared one string, which tells a crawler they are the same page — found by
// `seo: meta:unique:description`, which is advisory precisely because a shared
// description is a weakness rather than a break.
const description = page.currentPage === 1
  ? `Minden bejegyzés a(z) ${brand.siteName} oldalon, a legújabbtól.`
  : `${page.currentPage}. oldal a(z) ${page.lastPage}-ből — minden bejegyzés.`;
---
<RootLayout title={title} description={description}>
  <h1><Icon name="lucide:notebook-text" size={26} />Blog</h1>
  <p class="page-meta">
    {page.currentPage}. oldal / {page.lastPage} ·
    {page.start + 1}–{page.end + 1} / {page.total} bejegyzés
  </p>

  <div class="blog-grid">
    <main class="blog-main">
      <ul class="post-list">
        {page.data.map((p) => (
          <li>
            <div class="title">
              <a href={`/hu/blog/${urlSlug(p.id)}`}>{p.data.title}</a>
              {p.data.translationKey && (
                <span class="locale-badge" title="Vannak fordítások">
                  <Icon name="lucide:languages" size={11} />fordítva
                </span>
              )}
            </div>
            <div class="excerpt">{p.data.excerpt}</div>
            <div class="meta">
              <span><Icon name="lucide:calendar" size={12} />{p.data.date.toISOString().slice(0,10)}</span>
              <a href={`/hu/blog/type/${p.data.type}`}><Icon name="lucide:folder" size={12} />{p.data.type}</a>
              {p.data.tags.map((t) => (
                <a href={`/hu/blog/tag/${t}`}><Icon name="lucide:tag" size={12} />{t}</a>
              ))}
            </div>
          </li>
        ))}
      </ul>

      <Pagination page={page} />
    </main>

    <aside class="blog-aside">
      <section>
        <h2><Icon name="lucide:folder" size={14} />Típusok</h2>
        <ul class="filter-list">
          {sortedTypes.map(([type, count]) => (
            <li><a href={`/hu/blog/type/${type}`}>{type}<span class="c">{count}</span></a></li>
          ))}
        </ul>
      </section>
      <section>
        <h2><Icon name="lucide:tag" size={14} />Címkék</h2>
        <ul class="filter-list">
          {sortedTags.map(([tag, count]) => (
            <li><a href={`/hu/blog/tag/${tag}`}>{tag}<span class="c">{count}</span></a></li>
          ))}
        </ul>
      </section>
    </aside>
  </div>

  <style>
    h1 { display: flex; align-items: center; gap: 10px; }
    h1 [data-icon] { color: var(--accent); }
    .page-meta { color: var(--muted); font-size: 0.85em; font-variant-numeric: tabular-nums; }
    .blog-grid {
      display: grid;
      grid-template-columns: 1fr 200px;
      gap: 36px;
      margin-top: 24px;
    }
    @media (max-width: 720px) { .blog-grid { grid-template-columns: 1fr; } }
    .post-list .meta a {
      display: inline-flex;
      align-items: center;
      gap: 5px;
      color: var(--muted);
      padding: 1px 6px;
      border-radius: 3px;
      transition: color 150ms ease, background 150ms ease;
    }
    .post-list .meta a:hover { color: var(--accent); background: rgba(51, 255, 51, 0.06); text-decoration: none; }
    .blog-aside section { margin-bottom: 24px; }
    .blog-aside h2 {
      font-size: 0.7em;
      letter-spacing: 0.12em;
      text-transform: uppercase;
      color: var(--muted);
      font-weight: 700;
      display: flex; align-items: center; gap: 5px;
      margin: 0 0 8px;
    }
    .blog-aside h2 [data-icon] { color: var(--accent); }
    .blog-aside .filter-list { list-style: none; padding: 0; margin: 0; display: flex; flex-direction: column; gap: 2px; }
    .blog-aside .filter-list a {
      display: flex;
      justify-content: space-between;
      padding: 4px 8px;
      border-radius: 4px;
      color: var(--fg);
      font-size: 0.88em;
    }
    .blog-aside .filter-list a:hover { background: rgba(51, 255, 51, 0.06); color: var(--accent); text-decoration: none; }
    .blog-aside .filter-list .c { color: var(--muted); font-size: 0.85em; font-variant-numeric: tabular-nums; }
  </style>
</RootLayout>
