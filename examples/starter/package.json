{
  "name": "rider-starter",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "The rider starter \u2014 a single-locale Astro site that passes `rider --strict` clean. Copy it, rename it, write.",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "astro dev",
    "build": "node scripts/og.mjs && astro build",
    "preview": "wrangler dev",
    "types": "wrangler types",
    "check": "wrangler types && astro check",
    "sync": "astro sync",
    "audit": "node ../../tools/audit.mjs",
    "deploy": "node scripts/og.mjs && astro build && wrangler deploy",
    "verify": "node ../../tools/verify-example.mjs",
    "og": "node scripts/og.mjs",
    "media": "node scripts/media.mjs"
  },
  "dependencies": {
    "@astrojs/cloudflare": "^14.1.7",
    "@astrojs/mdx": "^8.0.0",
    "@astrojs/rss": "^4.0.19",
    "@astrojs/sitemap": "^3.7.3",
    "astro": "^7.2.6",
    "satori": "^0.33.4"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.10",
    "playwright": "^1.62.1",
    "typescript": "^6.0.3",
    "wrangler": "^4.42.2"
  }
}
